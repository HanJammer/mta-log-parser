# path where log file is placed, make sure docker has rights to read this folder
MAIL_LOG_PATH=/var/log
# log file name, make sure docker has rights to read this file
# may be a comma separated list and/or glob patterns relative to MAIL_LOG_PATH (absolute paths work too), e.g.
# MAIL_LOG_FILENAME=mail.log,mail.log.1   or   MAIL_LOG_FILENAME=mail.log*   or   MAIL_LOG_FILENAME=hosts/*/mail.log
# matching files are parsed oldest first (by modification time); .gz files are read transparently
MAIL_LOG_FILENAME=postfix.log

# mail server name stored for log lines without a syslog hostname field (lines in the usual syslog formats
# "2026-10-26T06:28:47.155158+00:00 mx1 postfix/smtpd[123]: ..." or "Oct 26 06:28:47 mx1 postfix/smtpd[123]: ..."
# carry the host themselves, so one central syslog file with many servers works without this)
#MAIL_HOST_NAME=mx1

# messages with several recipients get the status of their worst delivery (bounced > reject > deferred > sent);
# set to true to keep the 1.x catch-all status "multiple" instead
#LEGACY_MULTIPLE_STATUS=false

# recipients your servers add to (nearly) every message, e.g. an always_bcc archive copy: comma separated addresses
# or shell patterns (*@archive.local). They are left out of the recipient list, the recipient count, the status and
# the relay of a message, but are still listed in its details (marked "hidden"); a failed hidden delivery is noted
# in the status message. Applies to messages imported (or re-imported) after the change
#HIDDEN_RECIPIENTS=backup@archive.local

# show the original sender of SRS-rewritten envelope senders (postsrsd: SRS0=HHH=TT=example.com=john@srs.example.net
# -> john@example.com); the rewritten address is kept and shown as "SRS address"
#DECODE_SRS=true

# timezone of log timestamps that carry no UTC offset (BSD syslog "Oct 26 06:28:47", "2025-02-15 00:00:03");
# timestamps with an offset (RFC 3339) are always converted using that offset. pytz name, UTC by default
#LOG_TIMEZONE=Europe/Warsaw

# number of messages saved per database request while importing (500 by default)
#IMPORT_BATCH_SIZE=500

# lock file that exists while the importer runs (the web UI shows "processing" meanwhile);
# default: processing.lock in the application directory
#LOCK_FILE=/app/processing.lock

# Key that signs the session cookie: set a long random string (e.g. `openssl rand -base64 48`).
# If it is empty or a well-known default, a random key is generated and stored in instance/secret_key
# (docker: volume mlp_instance) and a warning is logged.
SECRET_KEY=
# set to true when the GUI is served over HTTPS (session cookie gets the Secure flag)
#SESSION_COOKIE_SECURE=true
# log in again after this many hours (default 12)
#SESSION_LIFETIME_HOURS=12
# login throttling: failed attempts allowed per (IP, login) / per IP within the window in seconds
#LOGIN_MAX_FAILURES=5
#LOGIN_MAX_FAILURES_IP=50
#LOGIN_THROTTLE_WINDOW=900

# group id that may read the mail log; the container runs as uid 1000 (4 = "adm" on Debian/Ubuntu)
#MAIL_LOG_GID=4

RETHINK_HOST=rethinkdb
RETHINK_DB=maildata
# Optional RethinkDB account. RethinkDB's "admin" user has no password by default; to set one run in the
# RethinkDB data explorer: r.db('rethinkdb').table('users').get('admin').update({password: '...'})
#RETHINK_USER=admin
#RETHINK_PASSWORD=
# change to portmap default Rethinkdb gui port from 8080 to your needs (bound to 127.0.0.1 only)
RETHINK_EXP_GUI_PORT=8080
# override the default query array limit in rethinkdb 100000
#RETHINK_ARR_LIMIT=500000
# give up on a single API query after this many seconds (default 60, 0 = no limit)
#QUERY_TIMEOUT=60

# LDAP authorization section, uncomment to use instead of internal authorization. LDAP_SEARCHFILTER is not mandatory, make sure to leave (%s=%s) in your filter as it is interpreted as (LDAP_USERNAME_ATTR = username), in ex. (sAMAccountName = username)
#LDAP_CONNECT='ldap://dc.domain.org:389'
# if you have issues with "Operation unavailable without authentication" try to force override LDAP version to 2 (default is 3)
#LDAP_VERSION=2
#LDAP_BIND_DN='CN=Administrator,OU=Users,DC=domain,DC=org'
#LDAP_BIND_DN_PWD='password'
#LDAP_SEARCHBASE='DC=domain,DC=org'
#LDAP_SEARCHFILTER='(%s=%s)'
#LDAP_USERNAME_ATTR='sAMAccountName'
#LDAP_USERNAME_DOMAIN_PART='domain.org'
# timeout in seconds for LDAP network operations (default 10)
#LDAP_TIMEOUT=10

# change web app bind host and port if necessary
HOST=0.0.0.0
PORT=8487

# add web app path prefix in case of using parser not in the root URL (location reverse proxy)
#PATH_PREFIX=/logs

# mail domain title
#MAIL_DOMAIN='example.com'

 # amount of logging days to keep (unset, empty or <= 0 = keep everything)
#HOUSEKEEPING_DAYS=30

# make date time format (default is "HH:mm:ss, DD.MM.YYYY") to use in GUI for emails list timestamps and date picker according to moment.js templates (https://momentjs.com/)
#DATETIME_FORMAT='HH:mm:ss, DD.MM.YYYY'

# set length of date time string in your log file to process by parser - eliminates many parsing errors, make sure to set properly so that parser won't get extra symbols to further process (20 chars by default)
# only used for unusual date formats: RFC 3339 / ISO 8601 and BSD syslog timestamps at the line start are recognised directly
# for example if your date in log looks like '2025-02-15 00:00:03.474' value 20 will use '2025-02-15 00:00:03.' to extract datetime
#DATETIME_INPUT_LENGTH = 20

# convert related logs timestamp according to the DATETIME_FORMAT. High CPU demanding! (false by default)
#MAIL_LOG_TIMESTAMP_CONVERT=false

# set MTA which logs you waunt to parse; available values are exim, postfix (default), sendmail and exchange
#MTA=postfix

# set email addresses to exclude from top senders stats permanently (comma separated)
#EXCLUDE_FROM_TOP_SENDERS='user1@example.com,user2@example.org'

# set email addresses to exclude from top recipients stats permanently (comma separated)
#EXCLUDE_FROM_TOP_RECIPIENTS='user1@example.com,user2@example.org'

# block GUI refresh while parser worker is running (true by default)
#GUI_REFRESH_BLOCK=false

# set GUI max log period in user setting menu (4320 minutes = 3 days by default)
#GUI_MAX_LOG_PERIOD=4320

# set startup command
# dev to run in python developer mode
# prod to run in production mode (default)
COMMAND=prod

